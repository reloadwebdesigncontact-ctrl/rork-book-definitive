{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/cgv.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/chat",
      "methods": ["POST", "OPTIONS"],
      "dest": "/api/chat.js"
    },
    {
      "src": "/cgv",
      "dest": "/api/cgv"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
