{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/chat",
      "methods": ["POST", "OPTIONS"],
      "dest": "/api/chat.js"
    },
    {
      "src": "/cgv",
      "dest": "/public/cgv.html"
    },
    {
      "src": "/cgv.html",
      "dest": "/public/cgv.html"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
