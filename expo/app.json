{
  "expo": {
    "name": "Summshine",
    "slug": "book-definitive",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coverscan",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F4604A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.coverscan",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Summshine to access your camera to scan book covers.",
        "NSMicrophoneUsageDescription": "Allow Summshine to access your microphone for audio reading.",
        "NSPhotoLibraryUsageDescription": "Allow Summshine to access your photos to select a book cover."
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "package": "app.coverscan",
      "versionCode": 135,
      "allowBackup": false,
      "blockedPermissions": [],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#F4604A",
          "imageResizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Summshine to access your camera to scan book covers.",
          "microphonePermission": "Allow Summshine to access your microphone for audio reading.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Summshine to access your photos to select a book cover."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "81256874-6600-42e5-8c5c-cbb8eaaf7d6f"
      }
    },
    "owner": "reload_10"
  }
}
